{
  "test_command": "npm test",
  "typecheck_command": "npm run typecheck",
  "lint_command": "npm run lint",
  "coverage_command": "",
  "setup_command": "npm ci",
  "models": {
    "small": "haiku",
    "standard": "sonnet",
    "orchestrate": "sonnet",
    "plan": "opus",
    "rescue": "fable"
  },
  "main_branches": [
    "main",
    "master"
  ],
  "protected": [
    "PROJECT.md",
    "CLAUDE.md",
    ".loop.json",
    "db/schema.sql",
    "prisma/schema.prisma",
    "**/schema.prisma",
    "docs/adr/**",
    ".github/workflows/**",
    "design/**"
  ],
  "tests": [
    "tests/**",
    "test/**",
    "**/__tests__/**",
    "**/test_*.py",
    "**/*_test.py",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*_test.go"
  ],
  "frontend": [
    "app/**/*.tsx",
    "src/app/**",
    "src/components/**",
    "src/pages/**",
    "apps/web/**",
    "components/**",
    "**/*.tsx",
    "**/*.jsx",
    "**/*.vue",
    "**/*.svelte",
    "**/*.css"
  ],
  "token_files": [
    "design/**",
    "**/tokens.css",
    "**/brand.css"
  ],
  "brand_overridable": [
    "--accent",
    "--accent-2",
    "--accent-soft",
    "--accent-rule",
    "--wash-1",
    "--wash-2",
    "--wash-3",
    "--font-serif",
    "--font-sans"
  ],
  "max_attempts": 3,
  "default_budget": {
    "files": 3,
    "lines": 200
  },
  "holdout": [
    "tests/holdout/**",
    "**/holdout/**"
  ],
  "context_budget": 150000,
  "release": {
    "staging_migrate": "",
    "staging_deploy": "",
    "staging_smoke": "",
    "prod_migrate": "",
    "prod_deploy": "",
    "prod_smoke": "",
    "require_go": true
  }
}
