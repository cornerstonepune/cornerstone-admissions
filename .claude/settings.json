{
  "extraKnownMarketplaces": {
    "loop": {
      "source": {
        "source": "github",
        "repo": "nimishshah1989/loop"
      }
    }
  },
  "enabledPlugins": {
    "loop@loop": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nimishshah/.local/bin/graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nimishshah/.local/bin/graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nimishshah/.local/bin/graphify hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}